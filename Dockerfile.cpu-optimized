# CPU-optimized Docker build for Ubuntu server without GPU
# Target: < 2GB image size, < 15 min build time

# Stage 1: Dependencies builder
FROM python:3.9-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    libopenblas-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy requirements
COPY requirements*.txt ./

# Create wheels with CPU-only versions
RUN pip install --upgrade pip setuptools wheel && \
    # Install CPU-only PyTorch (saves ~2GB vs CUDA version)
    pip install --no-cache-dir \
    torch==2.0.1+cpu torchvision==0.15.2+cpu torchaudio==2.0.2+cpu \
    -f https://download.pytorch.org/whl/torch_stable.html && \
    # Install other packages
    pip install --no-cache-dir \
    flask flask-jwt-extended flasgger python-dotenv pymongo requests \
    schedule "python-telegram-bot>=21.0.1,<23.0.0" "nest-asyncio>=1.6.0" \
    "langdetect>=1.0.9" "pyvi==0.1" "nltk==3.9b1" \
    scikit-learn "spacy>=3.0.0" keybert \
    # Install sentence-transformers without GPU dependencies
    "sentence-transformers>=3.0.0,<4.0.0" --no-deps && \
    pip install --no-cache-dir \
    transformers huggingface-hub numpy scipy torch \
    # Install BERTopic dependencies without CUDA
    "bertopic==0.16.0" --no-deps && \
    pip install --no-cache-dir \
    "hdbscan>=0.8.29" "umap-learn>=0.5.3" "numba>=0.57.0" \
    pandas tqdm plotly

# Stage 2: Runtime image
FROM python:3.9-slim

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas0 \
    libgomp1 \
    curl \
    ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -u 1000 appuser

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.9/site-packages /usr/local/lib/python3.9/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Set environment variables for CPU-only execution
ENV CUDA_VISIBLE_DEVICES=""
ENV TRANSFORMERS_OFFLINE=1
ENV HF_DATASETS_OFFLINE=1
ENV TOKENIZERS_PARALLELISM=false
ENV OMP_NUM_THREADS=2
ENV MKL_NUM_THREADS=2
ENV NUMEXPR_NUM_THREADS=2
ENV PYTHONUNBUFFERED=1

# Download minimal language models
RUN python -m spacy download en_core_web_sm && \
    python -c "import nltk; \
    nltk.download('punkt', download_dir='/usr/local/share/nltk_data'); \
    nltk.download('punkt_tab', download_dir='/usr/local/share/nltk_data'); \
    nltk.download('stopwords', download_dir='/usr/local/share/nltk_data'); \
    nltk.download('wordnet', download_dir='/usr/local/share/nltk_data'); \
    nltk.download('averaged_perceptron_tagger', download_dir='/usr/local/share/nltk_data'); \
    nltk.download('omw-1.4', download_dir='/usr/local/share/nltk_data')" && \
    rm -rf /root/.cache

ENV NLTK_DATA=/usr/local/share/nltk_data

# Copy application code
COPY --chown=appuser:appuser app /app/app
COPY --chown=appuser:appuser requirements*.txt /app/

# Create logs directory
RUN mkdir -p /app/logs && chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

EXPOSE 5003

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5003/health || exit 1

CMD ["python", "-m", "app.api"]